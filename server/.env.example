# Server port
PORT=4000

# URL of the frontend (used for CORS and for the "open in CRM" link inside
# Google Calendar event descriptions)
APP_URL=http://localhost:5173

# Google Calendar OAuth credentials — see README for how to create these.
# Never commit the real values; copy this file to .env and fill them in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# IANA timezone used for calendar events and "today" stats
TIMEZONE=America/Chicago

# SQLite database file (created automatically)
DB_PATH=./data/crm.db
