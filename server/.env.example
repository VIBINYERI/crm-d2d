# Server port (local dev only)
PORT=4000

# URL of the frontend. Locally this is the Vite dev server; on Vercel set it
# to your production URL (e.g. https://your-app.vercel.app). Used for CORS and
# for the "open in CRM" link inside Google Calendar event descriptions.
APP_URL=http://localhost:5173

# Postgres connection string. Leave empty for local dev — an embedded
# Postgres (PGlite) is used automatically, stored in server/data/pg.
# On Vercel this is REQUIRED: create a database in the Vercel dashboard
# (Storage tab → Create Database → Neon) and it's injected automatically.
DATABASE_URL=

# Google Calendar OAuth credentials — see README for how to create these.
# Never commit the real values; copy this file to .env and fill them in.
# On Vercel, set these as Environment Variables in the project settings, with
# GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# IANA timezone used for calendar events and "today" stats
TIMEZONE=America/Chicago
